<section>
  <div class="mb-12 rounded-3xl border border-stone-200 bg-white px-6 py-10 shadow-sm sm:px-10 sm:py-14">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-emerald-800">From the reading community</p>
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="font-serif text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">
          Discover books through readers.
        </h1>
        <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">
          Explore books, share your thoughts, and discover what other readers think.
        </p>
      </div>

      <% unless current_user %>
        <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
          <%= link_to "Get started", "/users/new", class: "inline-flex items-center justify-center rounded-xl bg-emerald-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800" %>
        </div>
      <% end %>
    </div>
  </div>

  <section id="reviews">
    <div class="mb-5 border-b border-stone-200 pb-5">
      <h2 class="font-serif text-2xl font-semibold text-slate-900">Latest reviews</h2>
      <p class="mt-1 text-sm text-slate-500">See what readers are saying about their books.</p>
    </div>

    <% if @reviews.any? %>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <% @reviews.each do |review| %>
          <article class="flex h-full flex-col rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-md">
            <h3 class="font-serif text-xl font-semibold leading-snug text-slate-900">
              <%= review.book.title %>
            </h3>

            <p class="mt-2 text-sm text-slate-500">
              Reviewed by <span class="font-semibold text-slate-700"><%= review.user.name %></span>
            </p>

            <p class="mt-3 text-amber-500" role="img" aria-label="<%= review.rating %> out of 5 stars">
              <%= "⭐" * review.rating %>
            </p>

            <p class="mt-3 flex-1 text-sm leading-6 text-slate-700">
              <%= review.comment %>
            </p>

            <p class="mt-5 border-t border-stone-100 pt-4 text-xs text-slate-500">
              <%= review.created_at.strftime("%d %B %Y") %>
            </p>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-12 text-center">
        <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50 text-xl text-emerald-900" aria-hidden="true">✦</span>
        <h3 class="mt-4 font-serif text-xl font-semibold text-slate-900">The conversation starts here</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">No reviews yet. Be the first to share your thoughts!</p>
      </div>
    <% end %>
  </section>
</section>
