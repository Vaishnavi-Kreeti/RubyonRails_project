<h1>Sign Up</h1>
<% if @user.errors.any? %>
    <div>
        <h2>
            <%=pluralize(@user.errors.count,"error")%> prevented sign up
        </h2>
        <ul>
            <%@user.errors.full_messages.each do|message|%>
            <li><%=message%></li>
            <%end%>
        </ul>
    </div>
<%end%>
<%= form_with model: @user, data: { turbo: false } do |form| %>
    <div>
        <%= form.label :name%>
        <%=form.text_field :name%>
    </div>
    <div>
        <%= form.label :email%>
        <%=form.text_field :email%>
    </div>
    <div>
        <%= form.label :password%>
        <%=form.text_field :password%>
    </div>
    <div>
        <%= form.label :password_confirmation%>
        <%=form.text_field :password_confirmation%>
    </div>
    <div>
        <%=form.submit "Sign Up"%>
    </div>
<%end%>
<p>Already have an account?
    <%=link_to "Login","/login"%>
</p>
