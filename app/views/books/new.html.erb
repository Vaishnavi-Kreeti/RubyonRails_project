<section class="mx-auto max-w-2xl">
  <%= link_to "← Back to your books", "/books", class: "text-sm font-semibold text-slate-500 transition hover:text-emerald-800" %>
  <div class="mt-6 rounded-3xl border border-stone-200 bg-white p-6 shadow-sm sm:p-9">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-800">Make room for a story</p>
    <h1 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">Add a book</h1>
    <p class="mt-2 text-sm leading-6 text-slate-600">A few details are all you need to add it to your library.</p>

    <% if @book.errors.any? %>
      <div class="mt-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800" role="alert">
        <p class="font-semibold"><%= pluralize(@book.errors.count, "thing") %> needs attention before this book can be saved:</p>
        <ul class="mt-2 list-inside list-disc space-y-1"><% @book.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <%= form_with model: @book, data: { turbo: false }, class: "mt-7 space-y-5" do |form| %>
      <div>
        <%= form.label :title, class: "mb-2 block text-sm font-semibold text-slate-700" %>
        <%= form.text_field :title, autofocus: true, required: true, placeholder: "e.g. The Secret Garden", class: "w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-emerald-700 focus:ring-4 focus:ring-emerald-900/10" %>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :author, class: "mb-2 block text-sm font-semibold text-slate-700" %>
          <%= form.text_field :author, placeholder: "Author name", class: "w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-emerald-700 focus:ring-4 focus:ring-emerald-900/10" %>
        </div>
        <div>
          <%= form.label :genre, class: "mb-2 block text-sm font-semibold text-slate-700" %>
          <%= form.text_field :genre, placeholder: "e.g. Fiction", class: "w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-emerald-700 focus:ring-4 focus:ring-emerald-900/10" %>
        </div>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= form.label :pages, class: "mb-2 block text-sm font-semibold text-slate-700" %>
          <%= form.number_field :pages, min: 101, placeholder: "Page count", class: "w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-emerald-700 focus:ring-4 focus:ring-emerald-900/10" %>
        </div>
        <div>
          <%= form.label :status, class: "mb-2 block text-sm font-semibold text-slate-700" %>
          <%= form.select :status, [["To be read", "To Be Read"], ["Reading", "Reading"], ["Done", "Done"]], { include_blank: "Choose a status" }, required: true, class: "w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-emerald-700 focus:ring-4 focus:ring-emerald-900/10" %>
        </div>
      </div>
      <div class="flex flex-col-reverse gap-3 border-t border-stone-100 pt-5 sm:flex-row sm:justify-end">
        <%= link_to "Cancel", "/books", class: "inline-flex items-center justify-center rounded-xl px-5 py-3 text-sm font-semibold text-slate-600 transition hover:bg-stone-100" %>
        <%= form.submit "Add to my library", class: "cursor-pointer rounded-xl bg-emerald-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800" %>
      </div>
    <% end %>
  </div>
</section>