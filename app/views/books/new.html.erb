<h1>Books todo app</h1>
<%= form_with model: @book do |form| %>
    <div>
        <%= form.label:title%>
        <%=form.text_field:title%>
    </div>
    <div>
        <%= form.label:author%>
        <%=form.text_field:author%>
    </div>
    <div>
        <%= form.label:pages%>
        <%=form.text_field:pages%>
    </div>
    <div>
        <%= form.label:status%>
        <%=form.text_field:status%>
    </div>
    <div>
        <%=form.submit "Add Book"%>
    </div>
<%end%>
