<section class="mx-auto max-w-3xl">
    <%= link_to "← Back to your books", "/books", class: "text-sm font-semibold text-slate-500 transition hover:text-emerald-800" %>
    <article class="mt-6 overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm">
        <div class="bg-emerald-950 px-6 py-10 text-white sm:px-10 sm:py-14">
            <span class="inline-flex rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-emerald-50"><%= @book.status %></span>
            <h1 class="mt-5 max-w-2xl font-serif text-4xl font-semibold tracking-tight sm:text-5xl"><%= @book.title %></h1>
            <p class="mt-3 text-lg text-emerald-100"><%= @book.author.presence || "Author unknown" %></p>
        </div>
        <div class="p-6 sm:p-10">
            <h2 class="font-serif text-xl font-semibold text-slate-900">Book details</h2>
            <dl class="mt-5 grid gap-5 border-y border-stone-100 py-6 sm:grid-cols-3">
                <div><dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Genre</dt><dd class="mt-2 text-sm font-medium text-slate-900"><%= @book.genre.presence || "Not specified" %></dd></div>
                <div><dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Length</dt><dd class="mt-2 text-sm font-medium text-slate-900"><%= @book.pages.present? ? pluralize(@book.pages, "page") : "Not specified" %></dd></div>
                <div><dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Reading status</dt><dd class="mt-2 text-sm font-medium text-slate-900"><%= @book.status %></dd></div>
            </dl>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
                <%= link_to "Edit book", "/books/#{@book.id}/edit", class: "inline-flex items-center justify-center rounded-xl bg-emerald-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-800" %>
                <%= button_to "Remove from library", "/books/#{@book.id}", method: :delete, data: { turbo_confirm: "Remove ‘#{@book.title}’ from your library?" }, class: "cursor-pointer rounded-xl border border-rose-200 bg-white px-5 py-3 text-sm font-semibold text-rose-700 transition hover:bg-rose-50" %>
            </div>
        </div>
    </article>
    <div style="margin-top: 80px;" class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm sm:p-10">
        <h2  class="font-serif text-2xl font-semibold text-slate-900">Write a Review</h2>
        <p class="mt-2 text-sm text-slate-500">Share your thoughts about this book.</p>
        <%= form_with model: Review.new,url: book_reviews_path(@book),class: "mt-6 space-y-5" do |form| %>
  <div>
    <%= form.label :rating, "Your rating",class: "mb-2 block text-sm font-semibold text-slate-700" %>
    <%= form.select :rating,
                    options_for_select([
                      ["⭐ 1 - Poor", 1],
                      ["⭐⭐ 2 - Fair", 2],
                      ["⭐⭐⭐ 3 - Good", 3],
                      ["⭐⭐⭐⭐ 4 - Very good", 4],
                      ["⭐⭐⭐⭐⭐ 5 - Excellent", 5]
                    ]),
                    { prompt: "Choose a rating" },required: true,class: "w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm" %>
  </div>
  <div>
    <%= form.label :comment, "Your review",class: "mb-2 block text-sm font-semibold text-slate-700" %>
    <%= form.text_area :comment,rows: 4,required: true,placeholder: "What did you think of this book?",class: "w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm" %>
  </div>
  <%= form.submit "Submit Review",class: "cursor-pointer rounded-xl bg-emerald-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-800" %>
<% end %>
    </div>
<div style="margin-top: 80px;" class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm sm:p-10">
  <h2 class="font-serif text-2xl font-semibold text-slate-900">
    Reviews
  </h2>

  <% if @book.reviews.any? %>
    <div class="mt-6 space-y-5">
      <% @book.reviews.each do |review| %>
        <article class="rounded-2xl border border-stone-200 p-5">
          <p class="font-semibold text-slate-900">
            <%= review.user.name %>
          </p>

          <p class="mt-2 text-amber-500">
            <%= "⭐" * review.rating %>
          </p>

          <p class="mt-3 text-sm leading-6 text-slate-700">
            <%= review.comment %>
          </p>

          <p class="mt-3 text-xs text-slate-500">
            Reviewed on <%= review.created_at.strftime("%d %b %Y") %>
          </p>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="mt-4 text-sm text-slate-500">
      No reviews yet. Be the first to review this book!
    </p>
  <% end %>
</div>
</section>

