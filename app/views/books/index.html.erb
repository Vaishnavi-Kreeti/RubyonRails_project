<section>
    <div class="mb-9 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-emerald-800">Your personal library</p>
            <h1 class="font-serif text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl">A little room to read.</h1>
            <p class="mt-3 max-w-xl text-base leading-7 text-slate-600">Keep track of the stories you’ve loved, the ones you’re reading, and what’s next.</p>
        </div>
        <%= link_to "/books/new", class: "inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-emerald-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-emerald-800" do %>
            <span aria-hidden="true" class="text-lg leading-none">+</span> Add a book
        <% end %>
    </div>

    <div class="mb-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-medium text-slate-500">In your library</p>
            <p class="mt-2 font-serif text-3xl font-semibold text-slate-900"><%= @book_count %></p>
            <p class="mt-1 text-xs text-slate-500">books collected</p>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Currently reading</p>
            <p class="mt-2 font-serif text-3xl font-semibold text-slate-900"><%= @reading_count %></p>
            <p class="mt-1 text-xs text-slate-500">stories in progress</p>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-medium text-slate-500">On your done shelf</p>
            <p class="mt-2 font-serif text-3xl font-semibold text-slate-900"><%= @done_count %></p>
            <p class="mt-1 text-xs text-slate-500">books finished</p>
        </div>
    </div>

    <div class="mb-5 flex flex-col gap-4 border-b border-stone-200 pb-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="font-serif text-2xl font-semibold text-slate-900">Your books</h2>
            <p class="mt-1 text-sm text-slate-500"><%= pluralize(@books.count, "book") %> in this view</p>
        </div>
        <%=form_with url: "/books", method: :get,data: {turbo:false},class: "flex w-full gap-2 sm:max-w-md" do |form|%>
            <%=form.label :status, "Filter by status", class: "sr-only" %>
            <%=form.select :status, options_for_select([["To be read", "To Be Read"], ["Reading", "Reading"], ["Done", "Done"]], params[:status]), include_blank: "All Status", class: "rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-emerald-700 focus:ring-4 focus:ring-emerald-900/10" %>
            <%=form.submit "Filter", class: "cursor-pointer rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-emerald-800 hover:text-emerald-900" %>
        <%end%>
        <%= form_with url: "/books", method: :get, data: { turbo: false }, class: "flex w-full gap-2 sm:max-w-md" do |form| %>
            <%= form.label :search, "Search your books", class: "sr-only" %>
            <%= form.search_field :search, value: params[:search], placeholder: "Search by title…", class: "min-w-0 flex-1 rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-emerald-700 focus:ring-4 focus:ring-emerald-900/10" %>
            <%= form.submit "Search", class: "cursor-pointer rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-emerald-800 hover:text-emerald-900" %>
        <% end %>
    </div>

    <% if @books.any? %>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            <% @books.each do |book| %>
                <article class="group relative flex min-h-56 flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-emerald-200 hover:shadow-md">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex min-w-0 items-start gap-4">
                            <div class="flex h-16 w-12 shrink-0 items-center justify-center rounded-lg bg-emerald-950 text-emerald-100 shadow-inner" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" class="h-7 w-7" stroke="currentColor" stroke-width="1.4"><path d="M5 4.75A2.75 2.75 0 0 1 7.75 2H20v17H7.75A2.75 2.75 0 0 0 5 21.75v-17Z"/><path d="M5 5v16.75M9 6h7M9 10h7"/></svg>
                            </div>
                            <div class="min-w-0">
                                <h3 class="truncate font-serif text-xl font-semibold leading-snug text-slate-900"><%= link_to book.title, "/books/#{book.id}", class: "after:absolute after:inset-0" %></h3>
                                <p class="mt-1 truncate text-sm text-slate-600"><%= book.author.presence || "Author unknown" %></p>
                            </div>
                        </div>
                        <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold <%= book.status == "Done" ? "bg-emerald-100 text-emerald-800" : book.status == "Reading" ? "bg-amber-100 text-amber-800" : "bg-stone-100 text-stone-700" %>"><%= book.status %></span>
                    </div>
                    <div class="mt-auto flex items-end justify-between gap-3 pt-8">
                        <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-500">
                            <% if book.genre.present? %><span><%= book.genre %></span><% end %>
                            <% if book.pages.present? %><span><%= pluralize(book.pages, "page") %></span><% end %>
                        </div>
                        <div class="relative z-10 flex items-center gap-3">
                            <%= link_to "Edit", "/books/#{book.id}/edit", class: "text-xs font-semibold text-slate-500 transition hover:text-emerald-800" %>
                            <%= button_to "Remove", "/books/#{book.id}", method: :delete, data: { turbo_confirm: "Remove ‘#{book.title}’ from your library?" }, class: "cursor-pointer border-0 bg-transparent p-0 text-xs font-semibold text-rose-600 hover:text-rose-800" %>
                        </div>
                    </div>
                </article>
            <% end %>
        </div>
    <% else %>
        <div class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-16 text-center">
            <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-50 text-2xl text-emerald-900" aria-hidden="true">✦</span>
            <h3 class="mt-5 font-serif text-2xl font-semibold text-slate-900"><%= params[:search].present? ? "No books found" : "Your shelf is waiting" %></h3>
            <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-600"><%= params[:search].present? ? "Try another title, or clear your search to see all your books." : "Add your first book and start building a library that feels like yours." %></p>
            <% if params[:search].present? %>
                <%= link_to "Clear search", "/books", class: "mt-6 inline-flex rounded-lg border border-stone-300 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:border-emerald-800 hover:text-emerald-900" %>
            <% else %>
                <%= link_to "Add your first book", "/books/new", class: "mt-6 inline-flex rounded-lg bg-emerald-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-800" %>
            <% end %>
        </div>
    <% end %>
</section>
