<h1>Books todo app</h1>
<h2>Update Books</h2>
<%= form_with model: @book do |form| %>
    <div>
        <%= form.label:title%>
        <%=form.text_field:title%>
    </div>
    <div>
        <%= form.label:author%>
        <%=form.text_field:author%>
    </div>
    <div>
        <%= form.label:pages%>
        <%=form.text_field:pages%>
    </div>
    <div>
        <%= form.label:status%>
        <%=form.text_field:status%>
    </div>
    <div>
        <%= form.label:genre%>
        <%=form.text_field:genre%>
    </div>
    <div>
        <%=form.submit "Update Book"%>
    </div>
<%end%>
