<section class="mx-auto max-w-md">
    <div class="rounded-3xl border border-stone-200 bg-white p-7 shadow-sm sm:p-9">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-800">Welcome back</p>
        <h1 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-slate-900">Your shelf is waiting.</h1>
        <p class="mt-2 text-sm leading-6 text-slate-600">Log in to pick up where your next great read begins.</p>
        <%= form_with url: "/login", method: :post, data: { turbo: false }, class: "mt-7 space-y-5" do |form| %>
            <div>
                <%= form.label :email, class: "mb-2 block text-sm font-semibold text-slate-700" %>
                <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, placeholder: "you@example.com", class: "w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-emerald-700 focus:ring-4 focus:ring-emerald-900/10" %>
            </div>
            <div>
                <%= form.label :password, class: "mb-2 block text-sm font-semibold text-slate-700" %>
                <%= form.password_field :password, autocomplete: "current-password", required: true, placeholder: "Your password", class: "w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-emerald-700 focus:ring-4 focus:ring-emerald-900/10" %>
            </div>
            <%= form.submit "Log in", class: "w-full cursor-pointer rounded-xl bg-emerald-900 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800" %>
        <% end %>
        <p class="mt-6 text-center text-sm text-slate-600">New to Shelf? <%= link_to "Create an account", "/users/new", class: "font-semibold text-emerald-800 hover:text-emerald-700" %></p>
    </div>
    <p class="mt-5 text-center text-xs text-slate-500">A calmer way to keep your reading life in one place.</p>
</section>

